{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3GetObjectSIEMLogs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::meddefense-siemlog-prod/*"
    },
    {
      "Sid": "S3ListBucketSIEMLogs",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::meddefense-siemlog-prod"
    },
    {
      "Sid": "CloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/siem-log-reader:*"
    }
  ]
}
