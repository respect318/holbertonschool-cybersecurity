alert ip 10.10.4.0/24 any -> !$HOME_NET !123 (msg:"MEDDEV to Internet"; classtype:policy-violation; sid:9000001; rev:1;)
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"Guest to SMB"; classtype:policy-violation; sid:9000002; rev:1;)
alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"Large Outbound From Server > 50 MB"; flow:established,to_server; stream_size:client,>,52428800; classtype:policy-violation; sid:9000003; rev:1;)
alert dns any any -> any any (msg:"DNS Tunneling Long Label"; dns.query; pcre:"/(^|\.)[a-zA-Z0-9-]{50,}(\.|$)/"; classtype:policy-violation; sid:9000004; rev:1;)
alert tcp 10.10.2.0/24 any -> !10.10.1.50 3306 (msg:"Clinical to Unauthorized DB"; classtype:policy-violation; sid:9000005; rev:1;)
alert tcp any any -> 10.10.4.0/24 23 (msg:"Telnet to MEDDEV"; classtype:policy-violation; sid:9000006; rev:1;)
